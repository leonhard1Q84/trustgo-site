# Enable internal account and rental adapters only for demo / acceptance deployments.
# Production builds remain closed when this is unset or false.
TRUSTGO_DEMO_MODE=

# Required for deployed demos; server only. Provision schema with scripts/setup-demo-database.mjs.
DATABASE_URL=

# Stable random secret (at least 32 characters) across redeployments; never NEXT_PUBLIC_*.
TRUSTGO_DEMO_QUOTE_SECRET=
